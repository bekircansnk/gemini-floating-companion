<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <!-- High-contrast dark glass surface (~80% opacity) ensuring crystal-clear readability even over bright/white video backgrounds -->
    <solid android:color="#CC0B1220" />
    <stroke
        android:width="1.2dp"
        android:color="#4DFFFFFF" />
    <padding
        android:bottom="8dp"
        android:left="14dp"
        android:right="14dp"
        android:top="8dp" />
</shape>
