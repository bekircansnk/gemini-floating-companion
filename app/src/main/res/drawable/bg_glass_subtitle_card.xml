<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <!-- Highly transparent dark glass surface (~22% opacity) for unobstructed video viewing in landscape -->
    <solid android:color="#380B1220" />
    <stroke
        android:width="1dp"
        android:color="#2BFFFFFF" />
    <padding
        android:bottom="8dp"
        android:left="14dp"
        android:right="14dp"
        android:top="8dp" />
</shape>
