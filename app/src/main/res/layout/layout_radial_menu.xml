<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radialMenuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Floating Radial Menu Glass Card -->
    <LinearLayout
        android:id="@+id/radialCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_radial_menu_pill"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Action 1: Live Voice Dictation -->
        <LinearLayout
            android:id="@+id/btnActionVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_action_circle"
                android:backgroundTint="#EEF2FF">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/action_dictation"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/gemini_blue" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/action_dictation"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/glass_border" />

        <!-- Action 2: Intelligent Vision OCR -->
        <LinearLayout
            android:id="@+id/btnActionOcr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_action_circle"
                android:backgroundTint="#F5F3FF">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/action_vision_ocr"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/gemini_purple" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/action_vision_ocr"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/glass_border" />

        <!-- Action 3: Smart Color PDF Document Scan -->
        <LinearLayout
            android:id="@+id/btnActionScanDoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_action_circle"
                android:backgroundTint="#ECFDF5">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/action_doc_scan"
                    android:src="@drawable/ic_document"
                    android:tint="#10B981" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/action_doc_scan"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/glass_border" />

        <!-- Action 4: Live Video & System Audio Translate -->
        <LinearLayout
            android:id="@+id/btnActionTranslateVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_action_circle"
                android:backgroundTint="#EFF6FF">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/action_video_translate"
                    android:src="@drawable/ic_translate"
                    android:tint="@color/gemini_blue" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/action_video_translate"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/glass_border" />

        <!-- Action 5: Close Button -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_action_circle"
            android:backgroundTint="#FEF2F2">

            <ImageView
                android:id="@+id/btnCloseMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/ripple_round"
                android:clickable="true"
                android:contentDescription="Kapat"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="#EF4444" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
