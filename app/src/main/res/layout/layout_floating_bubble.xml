<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="54dp"
    android:layout_height="54dp">

    <!-- Glowing halo (Kullanıcı istemediği için tamamen devre dışı) -->
    <View
        android:id="@+id/viewGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Main Glassmorphic Capsule (Kompakt 50dp daire - Asla pırpır etmez, titreşmez) -->
    <FrameLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_bubble"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/ivBubbleIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_gemini_sparkle" />

        <TextView
            android:id="@+id/tvBubbleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/gemini_blue"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
